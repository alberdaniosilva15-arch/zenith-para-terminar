# .env.example — template seguro para commitar
# Copia este ficheiro para .env e preenche com as tuas chaves reais
# NUNCA commitar o ficheiro .env com chaves reais!
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY
VITE_MAPBOX_TOKEN=pk.XXXX
VITE_AGORA_APP_ID=XXXX
# GEMINI_API_KEY NÃO VAI AQUI — vai como secret da Edge Function:
# npx supabase secrets set GEMINI_API_KEY="TUA_CHAVE"

# ── Gemini Live — voz natural do Kaze (áudio-para-áudio) ─────────────────────
# ⚠️ ATENÇÃO AO PREFIXO — é a armadilha que queimou a chave anterior.
#    O vite.config.ts tem:
#        envPrefix: ['VITE_', 'GEMINI_', 'GROQ_', 'OPENAI_', 'OPENROUTER_', 'RESEND_']
#    Tudo o que comece por um destes prefixos é INLINADO no JavaScript que vai
#    para o browser. Ou seja: uma variável chamada GEMINI_API_KEY em .env
#    acaba visível a qualquer visitante do site.
#
#    Por isso a chave local usa um nome fora desses prefixos:
# KAZE_GEMINI_KEY=AIza...
#
#    Quem lê a chave em runtime é o Edge Function `gemini-proxy`, através do
#    secret do Supabase (esse sim chama-se GEMINI_API_KEY, e é seguro porque
#    vive no servidor, nunca no bundle).
#    Nenhum ficheiro em src/ pode ler KAZE_GEMINI_KEY.

# Kaze Edge local (opcional para auto-start do motor edge)
KAZE_EDGE_PORT=4010
# KAZE_EDGE_COMMAND="caminho ou comando completo para arrancar o Kaze Edge"
# KAZE_EDGE_ENTRY="C:\\caminho\\para\\start.js"
# KAZE_EDGE_DIR="C:\\caminho\\para\\a\\pasta\\do\\kaze-agent"
# KAZE_ALLOW_INSECURE_TLS=1 # apenas diagnostico local temporario

# CRM Admin (para redirect do login)
# VITE_CRM_ADMIN_ORIGIN=https://admin.zenithride.ao

# Vigilante Engine (IA Admin) — activar APENAS em produção com monitorização de custos
# false = desactivado — protege quota gratuita Gemini (usar no MVP)
# true = activo — corre a cada 2min para cada admin logado (pode gerar custos)
VITE_VIGILANTE_ENABLED=false
